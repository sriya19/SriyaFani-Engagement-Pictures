{
  "name": "sriya-fani-engagement-album",
  "main": "worker.js",
  "compatibility_date": "2026-05-15",
  "assets": {"directory":"./dist","binding":"ASSETS","not_found_handling":"single-page-application","run_worker_first":["/api/*"]},
  "d1_databases": [{"binding":"DB","database_name":"sriya-fani-album","database_id":"00000000-0000-4000-8000-000000000000","migrations_dir":"migrations"}],
  "r2_buckets": [{"binding":"BUCKET","bucket_name":"sriya-fani-album-originals"}]
}
