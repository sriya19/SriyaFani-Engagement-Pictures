{
  "name": "sriya-fani-engagement-album",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {"node": ">=22.13.0"},
  "scripts": {
    "dev": "npm run build && wrangler dev",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "db:local": "wrangler d1 migrations apply DB --local",
    "db:remote": "wrangler d1 migrations apply DB --remote",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {"react": "19.2.6", "react-dom": "19.2.6"},
  "devDependencies": {"vite": "8.0.13", "wrangler": "4.92.0"}
}
